# ============================================================
#  TDDT — API Keys Configuration
#  Copia questo file in .env e inserisci le tue chiavi.
#  I moduli senza chiave vengono saltati automaticamente.
# ============================================================

# --- Hunter.io (Email Harvesting) ---
# Registrati su: https://hunter.io
# Free tier: 25 ricerche/mese
HUNTER_API_KEY=

# --- AlienVault OTX (Wayback / Threat Intel) ---
# Registrati su: https://otx.alienvault.com
# Free tier: illimitato
OTX_API_KEY=

# --- URLScan.io (Wayback / Deep OSINT) ---
# Registrati su: https://urlscan.io
# NOTA: la SEARCH è gratuita senza key.
# La key serve solo per submitiare nuove scansioni.
URLSCAN_API_KEY=

# --- urlDNA.io (Deep Analysis) ---
# Registrati su: https://urldna.io
# Free tier: URL scan, tech detection, threat intel
URLDNA_API_KEY=

# --- GrayhatWarfare (Bucket Finder) ---
# Registrati su: https://buckets.grayhatwarfare.com
# Free tier disponibile
GRAYHAT_API_KEY=

# --- External CLI Tools Paths (Opzionali) ---
# Se non hai 'photon' direttamente in PATH (es. usr/bin/photon),
# inserisci qui il percorso assoluto allo script photon.py su Linux:
# es. /opt/Photon/photon.py oppure /home/user/tools/Photon/photon.py
PHOTON_PATH=
