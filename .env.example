# ============================================================
#  TDDT v2 — API Keys & Configuration
#  Copy this file to .env and insert your optional API keys.
#  Modules without keys are automatically skipped (or you can pass --only-keyless).
# ============================================================

# --- GitHub Token (JS Secrets, Commit & Code Search) ---
# Create at: https://github.com/settings/tokens
GITHUB_TOKEN=

# --- Have I Been Pwned (HIBP) ---
# Key purchase: https://haveibeenpwned.com/API/Key
HIBP_API_KEY=

# --- DeHashed (Breach Search) ---
# Key: https://www.dehashed.com
DEHASHED_API_KEY=

# --- Truecaller (Phone OSINT) ---
# Truecaller auth token from mobile app installation
TRUECALLER_API_KEY=

# --- Hunter.io (Email Harvesting) ---
# Register at: https://hunter.io
HUNTER_API_KEY=

# --- AlienVault OTX (Passive DNS & Threat Intel) ---
# Register at: https://otx.alienvault.com
OTX_API_KEY=

# --- URLScan.io ---
# Register at: https://urlscan.io
URLSCAN_API_KEY=

# --- urlDNA.io ---
# Register at: https://urldna.io
URLDNA_API_KEY=

# --- GrayhatWarfare (Bucket Discovery) ---
# Register at: https://buckets.grayhatwarfare.com
GRAYHAT_API_KEY=

# --- External Tools (Optional) ---
# Path to photon.py if not in PATH
PHOTON_PATH=
